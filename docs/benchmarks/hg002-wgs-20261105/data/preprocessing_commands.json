{
  "v165": {
    "tool": "SOAPnuke 1.6.5",
    "argv": [
      "SOAPnuke-v1.6.5",
      "filter",
      "-1",
      "$R1",
      "-2",
      "$R2",
      "-C",
      "clean.R1.fastq.gz",
      "-D",
      "clean.R2.fastq.gz",
      "-o",
      "$OUT",
      "-T",
      "$T",
      "-l",
      "5",
      "-q",
      "0.5",
      "-n",
      "0.05",
      "--minLen",
      "30",
      "-Q",
      "2",
      "-G"
    ]
  },
  "v219_fixed": {
    "tool": "SOAPnuke 2.1.10",
    "argv": [
      "SOAPnuke-v2.1.9-report-fixed",
      "filter",
      "-1",
      "$R1",
      "-2",
      "$R2",
      "-C",
      "clean.R1.fastq.gz",
      "-D",
      "clean.R2.fastq.gz",
      "-o",
      "$OUT",
      "-T",
      "$T",
      "-l",
      "5",
      "-q",
      "0.5",
      "-n",
      "0.05",
      "-4",
      "30",
      "-c",
      "$PHRED_CONF"
    ]
  },
  "soapnuke300": {
    "tool": "SOAPnuke 3.0.0",
    "argv": [
      "SOAPnuke3",
      "process",
      "--r1",
      "$R1",
      "--r2",
      "$R2",
      "--out1",
      "$OUT/clean.R1.fastq.gz",
      "--out2",
      "$OUT/clean.R2.fastq.gz",
      "--report",
      "$OUT/qc.json",
      "--input-phred",
      "33",
      "--output-phred",
      "33",
      "--threads",
      "$T",
      "--decoder",
      "auto",
      "--low-q",
      "6",
      "--max-low-q-fraction",
      "0.5",
      "--max-n-fraction",
      "0.05",
      "--min-length",
      "30",
      "--pair-policy",
      "both-pass",
      "--gzip-level",
      "4"
    ]
  },
  "fastp140": {
    "tool": "fastp 1.4.0",
    "argv": [
      "fastp",
      "-i",
      "$R1",
      "-I",
      "$R2",
      "-o",
      "$OUT/clean.R1.fastq.gz",
      "-O",
      "$OUT/clean.R2.fastq.gz",
      "-w",
      "$T",
      "-A",
      "-G",
      "--dont_eval_duplication",
      "-q",
      "6",
      "-u",
      "50",
      "-n",
      "7",
      "-l",
      "30",
      "-j",
      "$OUT/fastp.json",
      "-h",
      "$OUT/fastp.html"
    ]
  },
  "trimmomatic": {
    "tool": "Trimmomatic 0.41",
    "argv": [
      "trimmomatic",
      "PE",
      "-threads",
      "$T",
      "-phred33",
      "-validatePairs",
      "-compressLevel",
      "4",
      "-summary",
      "$OUT/summary.txt",
      "$R1",
      "$R2",
      "$OUT/clean.R1.fastq.gz",
      "$OUT/singleton.R1.fastq.gz",
      "$OUT/clean.R2.fastq.gz",
      "$OUT/singleton.R2.fastq.gz",
      "LEADING:20",
      "TRAILING:20",
      "BASECOUNT:N:0:7",
      "MINLEN:30"
    ]
  },
  "cutadapt": {
    "tool": "Cutadapt 5.2",
    "argv": [
      "cutadapt",
      "-j",
      "$T",
      "--quality-base",
      "33",
      "-q",
      "20,20",
      "--max-n",
      "0.05",
      "--minimum-length",
      "30",
      "--pair-filter",
      "any",
      "--compression-level",
      "4",
      "--json",
      "$OUT/qc.json",
      "-o",
      "$OUT/clean.R1.fastq.gz",
      "-p",
      "$OUT/clean.R2.fastq.gz",
      "$R1",
      "$R2"
    ]
  }
}
